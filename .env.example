# Copiez ce fichier en ".env" (dans plateforme_web/) et remplissez les valeurs.
# Ce fichier ne doit jamais être partagé ni versionné.

# Clé secrète utilisée pour signer les sessions de connexion (obligatoire).
# Mettez une longue chaîne aléatoire, différente entre développement et production.
SECRET_KEY=

# Base de données. Laissez vide en local (utilise un fichier SQLite automatiquement).
# En production sur Railway, sera fournie automatiquement par l'extension PostgreSQL.
DATABASE_URL=

# Les clés suivantes seront utilisées à partir de l'étape "Génération de posts" :
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OVH_FTP_HOTE=
OVH_FTP_UTILISATEUR=
OVH_FTP_MOTDEPASSE=
OVH_FTP_DOSSIER=www/images-posts
OVH_URL_PUBLIQUE_BASE=

# Carte de positions par mots-cles (optionnel) : compte a creer sur dataforseo.com
# (facture a l'usage, depot minimum ~$50). Sans ces identifiants, la page
# "Positions" reste accessible mais indique qu'aucune verification n'est possible.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Envoi du recap mensuel par e-mail (Brevo, https://app.brevo.com). L'adresse
# expeditrice doit etre verifiee (ou le domaine authentifie) cote Brevo. Sans
# ces identifiants, le recap mensuel automatique echoue silencieusement
# (erreur journalisee dans la page "Recap mensuel").
BREVO_API_KEY=
BREVO_EMAIL_EXPEDITEUR=
BREVO_NOM_EXPEDITEUR=Fiche Locale
# Numero WhatsApp propose comme second moyen de reponse dans le recap
# (optionnel) - format international sans espaces ni "+", ex. 33612345678.
RECAP_WHATSAPP_NUMERO=
